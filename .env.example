# ProjectSync configuration. Copy this file to `.env` and put your values in it.
#
# `.env` is in `.gitignore`. Do not remove that line, and do not commit `.env`.
#
# The first four names are read by the Google GenAI SDK itself. Do not change
# them. If you use a different name, the SDK ignores the value and calls the
# direct Gemini API. A name such as `USE_VERTEX_AI` or `GEMINI_API_KEY` is
# silently ignored.

# --------------------------------------------------------------------------
# Model
# --------------------------------------------------------------------------

# The hackathon rules give a floor of Gemini 3.5. `config.py` stops the
# application at import if this value is below the floor.
MODEL_ID=gemini-3.7-flash

# --------------------------------------------------------------------------
# The route to Gemini. Choose one of the two blocks below.
# --------------------------------------------------------------------------

# Block A: the direct Gemini API. Use this block for local work.
# Get a key at https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_VERTEXAI=False
GOOGLE_API_KEY=

# Block B: Vertex AI. Use this block on Cloud Run.
# Set GOOGLE_GENAI_USE_VERTEXAI to True, leave GOOGLE_API_KEY empty, and give
# the project and the location.
# GOOGLE_GENAI_USE_VERTEXAI=True
# GOOGLE_CLOUD_LOCATION=global

# The project is also necessary for Firestore.
GOOGLE_CLOUD_PROJECT=

# --------------------------------------------------------------------------
# GitHub
# --------------------------------------------------------------------------

# A fine-grained token, or a classic token with the `repo` scope. The token must
# read the repository that it scans and write the two commits.
# Make one at https://github.com/settings/tokens
GITHUB_TOKEN=

# The private repository for the portfolio cards. The format is `owner/name`.
PORTFOLIO_DATA_REPO=

# The folder inside the scanned repository for the generated documentation
# sheets. This folder keeps the generated files apart from the files that a
# person wrote.
SYNCED_DOCS_PATH=docs/synced

# --------------------------------------------------------------------------
# Firestore collections
# --------------------------------------------------------------------------

FIRESTORE_TRANSACTIONS=projectsync_transactions
FIRESTORE_STYLE_RULES=style_rules
FIRESTORE_USERS=users

# --------------------------------------------------------------------------
# The client
# --------------------------------------------------------------------------

DASHBOARD_BASE_URL=http://localhost:8080
